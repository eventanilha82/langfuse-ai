# Application
APP_ENV=local

# OCI Generative AI endpoint.
# O backend exige OCI_API_KEY real; não há fallback determinístico.
OCI_API_KEY=
OCI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/20231130/actions/v1
OCI_MODEL_ID=openai.gpt-5.5

# Langfuse local project created by docker-compose.yml
LANGFUSE_PUBLIC_KEY=pk-lf-workshop
LANGFUSE_SECRET_KEY=sk-lf-workshop
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_AVAILABILITY_CHECK=true

# Prompt Management
LANGFUSE_PROMPT_NAME=oracle-ai-lab-assistant
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=0

# MCP tools used by OpenAI Agents SDK
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/mcp
DEEPWIKI_MCP_AUTH_TOKEN=
MCP_REQUEST_TIMEOUT_SECONDS=45
MCP_SSE_READ_TIMEOUT_SECONDS=300
MCP_CLIENT_SESSION_TIMEOUT_SECONDS=15
MCP_MAX_RETRY_ATTEMPTS=2
MCP_RETRY_BACKOFF_SECONDS_BASE=2.0
MCP_CACHE_TOOLS_LIST=true
